# file-mcp settings. Required values are left empty.
# Generate each secret with: openssl rand -base64 48
# Keep the real file mode 600. Never pass secrets on the command line.

FILE_MCP_HOST=0.0.0.0
FILE_MCP_PORT=8081

# http or https, no path, query, or fragment.
FILE_MCP_PUBLIC_BASE_URL=

# Keystone registry entry name. This is the assertion audience.
FILE_MCP_REGISTRY_NAME=file-mcp

# openssl rand -base64 48
FILE_MCP_BEARER_TOKEN=

# openssl rand -base64 48
FILE_MCP_IDENTITY_SECRET=

# Optional previous identity secret, used while rotating. openssl rand -base64 48
FILE_MCP_IDENTITY_SECRET_PREVIOUS=

# Optional. When set, the assertion iss claim must match.
FILE_MCP_IDENTITY_ISSUER=

# openssl rand -base64 48
FILE_MCP_SIGNING_SECRET=

FILE_MCP_S3_ENDPOINT=
FILE_MCP_S3_BUCKET=
FILE_MCP_S3_ACCESS_KEY=
FILE_MCP_S3_SECRET_KEY=
FILE_MCP_S3_REGION=us-east-1
FILE_MCP_S3_PATH_STYLE=true
FILE_MCP_S3_STARTUP_TIMEOUT_SECONDS=60

FILE_MCP_LINK_TTL_SECONDS=900
FILE_MCP_UPLOAD_TTL_DAYS=30
FILE_MCP_MAX_BYTES=104857600
FILE_MCP_LOG_LEVEL=INFO
